########################################
# Werewolf Arena Render Docker Image #
# 单端口部署适配Render平台          #
########################################

# --- Frontend build stage ---------------------------------------------------
FROM node:18-alpine AS frontend-builder
WORKDIR /app/frontend

ENV NEXT_PUBLIC_API_URL=/api \
    NEXT_PUBLIC_WS_URL=wss://werewolf-arena.onrender.com

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ .
RUN npm run build

# --- Backend dependency stage -----------------------------------------------
FROM python:3.11-alpine AS backend-builder
WORKDIR /app/backend

COPY backend/requirements.txt .
RUN pip install --upgrade pip \
    && pip wheel --wheel-dir /tmp/wheels -r requirements.txt

COPY backend/ .

# --- Final runtime image ----------------------------------------------------
FROM python:3.11-alpine
WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    FRONTEND_BUILD_PATH=/app/frontend/.next/standalone \
    FRONTEND_STATIC_PATH=/app/frontend/.next/static \
    NEXT_PUBLIC_API_URL=/api \
    NEXT_PUBLIC_WS_URL=wss://werewolf-arena.onrender.com

# Install backend dependencies from cached wheels
COPY --from=backend-builder /tmp/wheels /tmp/wheels
COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-index --find-links=/tmp/wheels -r /app/backend/requirements.txt \
    && apk add --no-cache bash nodejs

# Copy application code
COPY --from=backend-builder /app/backend /app/backend
COPY --from=frontend-builder /app/frontend/.next/standalone /app/frontend/.next/standalone
COPY --from=frontend-builder /app/frontend/.next/static /app/frontend/.next/static
COPY --from=frontend-builder /app/frontend/public /app/frontend/.next/standalone/public

# Copy Render-specific startup script
COPY scripts/start_combined.sh /app/start.sh

RUN chmod +x /app/start.sh

# Expose the single port that Render will use (10000)
EXPOSE 10000

ENTRYPOINT ["/app/start.sh"]
