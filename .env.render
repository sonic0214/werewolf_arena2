# ========================================
# Werewolf Arena Render部署环境变量
# Render Deployment Environment Variables
# ========================================

# 应用基础配置
ENVIRONMENT=production
DEBUG=false
NODE_ENV=production
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Render端口配置 - Render会自动设置PORT环境变量
PORT=3000
BACKEND_PORT=8000

# URL配置 - 部署后需要更新为实际的Render URL
BACKEND_URL=https://werewolf-arena.onrender.com
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_WS_URL=wss://werewolf-arena.onrender.com

# LLM API配置 - 至少需要配置一个（在Render控制台中设置）
GLM_API_KEY=your-glm-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
MINIMAX_API_KEY=your-minimax-api-key-here
SILICONFLOW_API_KEY=your-siliconflow-api-key-here

# 默认使用的模型
DEFAULT_MODEL=siliconflow/deepseek-ai/DeepSeek-V3
DEFAULT_LLM_PROVIDER=siliconflow

# 游戏配置
GAME__NUM_PLAYERS=6
GAME__MAX_DEBATE_TURNS=2
GAME__DEFAULT_THREADS=4
GAME__RETRIES=2
GAME__RUN_SYNTHETIC_VOTES=true
GAME__DEBATE_CONCURRENT=1
GAME_TIMEOUT_SECONDS=300
MAX_PLAYERS=20
MIN_PLAYERS=4

# 服务器配置
SERVER__HOST=0.0.0.0
SERVER__PORT=8000
SERVER__RELOAD=false
SERVER__LOG_LEVEL=info
SERVER__WORKERS=1

# CORS配置 - 生产环境需要设置为实际域名
CORS__ALLOW_ORIGINS=["https://werewolf-arena.onrender.com","https://werewolf-arena.vercel.app"]

# 项目信息
PROJECT_NAME=Werewolf Arena API
VERSION=2.0.0