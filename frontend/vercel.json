{
  "version": 2,
  "name": "werewolf-arena-frontend",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "https://werewolf-arena-backend.fly.dev",
    "NEXT_PUBLIC_WS_URL": "wss://werewolf-arena-backend.fly.dev"
  },
  "regions": ["sin"],
  "functions": {
    "src/app/**/*.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://werewolf-arena-backend.fly.dev/api/:path*"
    }
  ]
}